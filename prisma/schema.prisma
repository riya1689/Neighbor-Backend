// Neighbo uses Neon (PostgreSQL). Runtime URL is normalized in src/config/env.js
// (sslmode=require; pgbouncer=true when using a *pooler* host).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Neighborhood {
  id          String @id @default(uuid())
  name        String @unique
  description String

  users User[]
  posts Post[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  posts Post[]
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            Role           @default(USER)
  neighborhoodId  String?
  neighborhood    Neighborhood?  @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  posts Post[]
}

model Post {
  id             String   @id @default(uuid())
  title          String
  content        String
  images         String[]
  isPremium      Boolean  @default(false)
  price          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId         String
  neighborhoodId String
  categoryId     String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}
