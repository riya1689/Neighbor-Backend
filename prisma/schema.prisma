// Neighbo uses Neon (PostgreSQL). Runtime URL is normalized in src/config/env.js
// (sslmode=require; pgbouncer=true when using a *pooler* host).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Neighborhood {
  id          String @id @default(uuid())
  name        String @unique
  description String

  users User[]
  posts Post[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  posts Post[]
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            Role           @default(USER)
  neighborhoodId  String?
  neighborhood    Neighborhood?  @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  posts Post[]
  comments Comment[]

  // Social graph (self-relation through Follow join table)
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")
}

model Post {
  id             String   @id @default(uuid())
  title          String
  content        String
  images         String[]
  isPremium      Boolean  @default(false)
  price          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId         String
  neighborhoodId String
  categoryId     String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}
